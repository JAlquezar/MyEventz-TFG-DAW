# ==========================================
# MyEventz Consolidated .gitignore
# ==========================================

# ------------------------------------------
# 1. OS & System Files (General)
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# 2. Editors & IDEs (VS Code, Visual Studio, JetBrains)
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Visual Studio
.vs/
[Dd]ebug/
[Dd]ebugPS/
[Rr]elease/
[Rr]eleasePS/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bincode/
[Ob]j/
*.user
*.userosscache
*.sln.docstates

# JetBrains Rider / WebStorm / Rider
.idea/
*.sln.iml
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ------------------------------------------
# 3. .NET 8 / C# (Backend)
# ------------------------------------------
# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Roslyn cache directories
.vs-analytics/

# MSTest test results
TestResults/
[Bb]uildLog.struct
[Bb]uildLog.xml

# Visual Studio cache files
# MyEventz.sln.DotSettings.user
*.DotSettings.user

# User Secrets
secrets.json

# Backup & generated files
*~
*.stackdump
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vsscc
App_Data/jobs/
App_Data/DataAccess/

# ------------------------------------------
# 4. Node.js / React (Frontend & Backend Scripts)
# ------------------------------------------
# Dependencies
node_modules/
jspm_packages/
web_modules/

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-gyp compilation folder
build/Release

# Dependency directories (yallist, etc.)
.lock-wscript

# ------------------------------------------
# 5. Environments, Credentials and Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# Firebase configuration local tokens
.firebase/
firebaserc
firebase-debug.log
ui-debug.log

# ------------------------------------------
# 6. Docker
# ------------------------------------------
# Local volumes or temp docker data (not including docker-compose)
.docker/
docker-compose.override.yml

# ------------------------------------------
# 7. Documentation
# ------------------------------------------
Documentación - MyEventz.docx
extracted_doc.txt
